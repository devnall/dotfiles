# SSH config — managed by dotfiles
# Symlinked to ~/.ssh/config via Dotbot.
#
# Machine-specific hosts (private IPs, internal hostnames, etc.) go in
# ~/.ssh/config.local, which is not tracked by dotfiles.
Include ~/.ssh/config.local

# The 1Password agent serves every stored key, so a bare Host * makes git offer
# all of them to GitHub, prompting for each. Pin each GitHub host to one key
# (IdentityAgent is inherited from Host * below). The GitHub account is shared
# between work and personal, but the keys are NOT interchangeable: the callrail
# org enforces SAML SSO and only the work key is authorized for it.
#
# github.com uses the personal key. CallRail repos go through the github-work
# alias instead — config/git/config rewrites callrail URLs to it, so clones,
# fetches and pushes pick the work key by org, not by directory. Both pubkeys
# are generated by bootstrap from the signingkeys in .gitconfig-user /
# .gitconfig-work (gitignored); machines without work config have no work key,
# so only callrail repos fail there.
Host github.com
  IdentitiesOnly yes
  IdentityFile ~/.dotfiles/config/git/personal_github.pub

Host github-work
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.dotfiles/config/git/work_github.pub

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityAgent "~/.1p-agent.sock"
