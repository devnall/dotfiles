#!/usr/bin/env bash
#
# rex-config-reload — make a running Rex server re-read ~/.config/rex/init.lua
# so host changes pulled from the repo take effect (see docs/RUNBOOK.md § Rex).
#
# No-op (exit 0) where rex isn't installed or no local server is running; a
# server that starts later reads the file on its own. Never starts a server.
#
# Run by ./install. Safe to run by hand:
#   rex-config-reload

set -uo pipefail

command -v rex >/dev/null 2>&1 || exit 0

if ! rex --autostart=false --timeout 5s server status >/dev/null 2>&1; then
  echo "Rex server not running; it will read init.lua when it starts."
  exit 0
fi

if rex --autostart=false --timeout 5s config reload; then
  echo "Rex config reloaded."
else
  echo "⚠ Rex config reload failed. Run 'rex config check' to see why."
fi
exit 0
